# shellcheck shell=bash
# installers/hermes — environment defaults
#
# Sourced by install.sh and by components running standalone. Every variable
# is `${VAR:-default}` style: shell env wins, this file fills in the rest.
# To override at run time, export the variable before invoking install.sh,
# e.g. `HERMES_BRANCH=develop HONCHO_API_PORT=50041 ./install.sh`.
#
# Most values are byte-identical to corresponding lines in
# ../setup-ubuntu24-ultimate.sh; out-of-scope blocks (Langfuse, Multica, Open
# WebUI, Hermes WebUI) are omitted, and the AI-tools / local-Ollama section
# is new code (no upstream equivalent).
#
# ┌──────────────────────── PORT REGISTRY ────────────────────────┐
# │  All EIP/Hermes native services occupy 50000-50999, bound to  │
# │  127.0.0.1, to avoid colliding with labs and target services. │
# │  See PORTS.md for the full table. Slots reserved-but-unused   │
# │  by other installers must not be reused here.                 │
# │                                                                │
# │  In scope here:                                                │
# │    50000  Hermes API gateway       HERMES_API_PORT             │
# │    50010  Hermes dashboard         HERMES_DASHBOARD_PORT       │
# │    50040  Honcho API               HONCHO_API_PORT             │
# │                                                                │
# │  Documented exception (third-party, well-known port):          │
# │    11434  Ollama API               OLLAMA_PORT                 │
# │                                                                │
# │  Reserved (other installers, do not reuse):                    │
# │    50020  Langfuse web                                         │
# │    50030  mcpo OpenAPI bridge                                  │
# │    50050  Multica backend                                      │
# │    50060  Multica frontend                                     │
# │    50070  Open WebUI                                           │
# │    50080  Hermes WebUI                                         │
# │    50090  Langfuse MinIO API                                   │
# │    50091  Langfuse MinIO console                               │
# └────────────────────────────────────────────────────────────────┘

# ----------------------------- AI tools -------------------------------------
# Ollama runtime + agent CLIs (Claude Code, Codex). Installed by the ai-tools
# component. Ollama listens on 127.0.0.1:11434 — see PORTS.md for why this is
# the documented exception to the 50000-50999 native-services convention.
# Defined first so later blocks (Honcho LLM defaults) can reference OLLAMA_*.
OLLAMA_INSTALL_URL="${OLLAMA_INSTALL_URL:-https://ollama.com/install.sh}"
OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1}"
OLLAMA_PORT="${OLLAMA_PORT:-11434}"
CLAUDE_INSTALL_URL="${CLAUDE_INSTALL_URL:-https://claude.ai/install.sh}"
NODE_MAJOR="${NODE_MAJOR:-22}"
INSTALL_OLLAMA="${INSTALL_OLLAMA:-true}"
INSTALL_NODE="${INSTALL_NODE:-true}"
INSTALL_CLAUDE_CODE="${INSTALL_CLAUDE_CODE:-true}"
INSTALL_CODEX="${INSTALL_CODEX:-true}"

# ----------------------------- Hermes ---------------------------------------
HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
HERMES_REPO_URL="${HERMES_REPO_URL:-https://github.com/NousResearch/hermes-agent.git}"
HERMES_BRANCH="${HERMES_BRANCH:-main}"
HERMES_INSTALL_DIR="${HERMES_INSTALL_DIR:-$HERMES_HOME/hermes-agent}"
# Playwright's bundled Chromium for hermes browser_*/browser-cdp/computer_use
# tools. Set to false on truly headless hosts that won't run browser automation.
INSTALL_PLAYWRIGHT_CHROMIUM="${INSTALL_PLAYWRIGHT_CHROMIUM:-true}"

# ----------------------------- Honcho ---------------------------------------
HONCHO_REPO_URL="${HONCHO_REPO_URL:-https://github.com/plastic-labs/honcho.git}"
HONCHO_BRANCH="${HONCHO_BRANCH:-main}"
HONCHO_DIR="${HONCHO_DIR:-$HOME/.local/share/honcho}"
HONCHO_API_PORT="${HONCHO_API_PORT:-50040}"
HONCHO_BASE_URL="${HONCHO_BASE_URL:-http://127.0.0.1:${HONCHO_API_PORT}}"
HONCHO_WORKSPACE="${HONCHO_WORKSPACE:-hermes}"
HONCHO_USER_PEER="${HONCHO_USER_PEER:-user}"
HONCHO_AI_PEER="${HONCHO_AI_PEER:-hermes}"
HONCHO_SESSION_STRATEGY="${HONCHO_SESSION_STRATEGY:-per-directory}"
HONCHO_RECALL_MODE="${HONCHO_RECALL_MODE:-hybrid}"
HONCHO_CONTEXT_CADENCE="${HONCHO_CONTEXT_CADENCE:-1}"
HONCHO_DIALECTIC_CADENCE="${HONCHO_DIALECTIC_CADENCE:-3}"
HONCHO_DIALECTIC_DEPTH="${HONCHO_DIALECTIC_DEPTH:-1}"
HONCHO_DIALECTIC_REASONING_LEVEL="${HONCHO_DIALECTIC_REASONING_LEVEL:-low}"

# LLM provider used by Honcho's deriver/dialectic/summary/dream pipelines.
# Defaults wire Honcho to the local Ollama installed by the ai-tools component
# (reached from Honcho's Docker container via host.docker.internal). To use
# cloud OpenAI/OpenRouter instead, export OPENAI_API_KEY (or LLM_OPENAI_API_KEY)
# and LLM_BASE_URL/LLM_MODEL before running install.sh; those win.
LLM_MODEL="${LLM_MODEL:-}"
LLM_BASE_URL="${LLM_BASE_URL:-http://host.docker.internal:${OLLAMA_PORT}/v1}"
LLM_API_KEY="${LLM_OPENAI_API_KEY:-${OPENAI_API_KEY:-ollama}}"
HOST_DNS_SERVER="${HOST_DNS_SERVER:-}"

# ------------------------ Hermes control plane ------------------------------
HERMES_API_HOST="${HERMES_API_HOST:-127.0.0.1}"
HERMES_API_PORT="${HERMES_API_PORT:-50000}"
HERMES_DASHBOARD_HOST="${HERMES_DASHBOARD_HOST:-127.0.0.1}"
HERMES_DASHBOARD_PORT="${HERMES_DASHBOARD_PORT:-50010}"
HERMES_KANBAN_BOARD="${HERMES_KANBAN_BOARD:-hermes-ops}"
HERMES_KANBAN_BOARD_NAME="${HERMES_KANBAN_BOARD_NAME:-Hermes Ops}"
HERMES_KANBAN_BOARD_DESCRIPTION="${HERMES_KANBAN_BOARD_DESCRIPTION:-Hermes/Honcho/Langfuse/Multica agent operations board}"
HERMES_KANBAN_DISPATCH_INTERVAL="${HERMES_KANBAN_DISPATCH_INTERVAL:-60}"

# mcpo bridge is out of scope here. These vars stay defined so the extracted
# control-plane functions (which reference them inside dead, INSTALL_MCPO=false
# branches) remain byte-identical and runnable under `set -u`.
HERMES_MCP_OPENAPI_HOST="${HERMES_MCP_OPENAPI_HOST:-127.0.0.1}"
HERMES_MCP_OPENAPI_PORT="${HERMES_MCP_OPENAPI_PORT:-50030}"
MCPO_CONFIG_PATH="${MCPO_CONFIG_PATH:-/etc/mcpo/config.json}"
INSTALL_MCPO="${INSTALL_MCPO:-false}"

# ------------------------- Component toggles --------------------------------
# Generic flags consumed by all components. Overridden by install.sh CLI args.
NON_INTERACTIVE="${NON_INTERACTIVE:-false}"
FORCE="${FORCE:-false}"

# Per-component skip flags read by extracted functions. Defaults preserve the
# upstream "do the work" behavior. The orchestrator flips these via --skip.
INSTALL_APT="${INSTALL_APT:-true}"
INSTALL_DOCKER="${INSTALL_DOCKER:-true}"
INSTALL_HERMES="${INSTALL_HERMES:-true}"
CONFIGURE_HERMES="${CONFIGURE_HERMES:-true}"
START_STACKS="${START_STACKS:-true}"
SETUP_HERMES_CONTROL_PLANE="${SETUP_HERMES_CONTROL_PLANE:-true}"
SETUP_HONCHO="${SETUP_HONCHO:-false}"
SETUP_AGENT_CONTEXT="${SETUP_AGENT_CONTEXT:-true}"
HERMES_AGENT_CONTEXT_FORCE="${HERMES_AGENT_CONTEXT_FORCE:-false}"

# --------------------- CVE skills clone (25-cve-skills) --------------------
# Where Hermes loads the EIP CVE research skill library from. Cloned by the
# cve-skills component into $HERMES_HOME/skills/eip-cve by default.
CVE_SKILLS_REPO_URL="${CVE_SKILLS_REPO_URL:-https://github.com/eip-public/security-skills.git}"
CVE_SKILLS_BRANCH="${CVE_SKILLS_BRANCH:-main}"
# CVE_SKILLS_DIR defaults to $HERMES_HOME/skills/eip-cve (computed inside the
# component, after HERMES_HOME is resolved).

# --------------------- Win11 lab-host toggles (91-lab-host) ----------------
# Default-enabled. Clones win11-forge into WINFORGE_DIR (defaults to the
# invoking user's $HOME/win11-forge). The heavy lab dependencies
# (KVM/libvirt/qemu/ovmf, ghidriff, BinExport, Win11/virtio ISOs) are NOT
# installed by this component — run `~/win11-forge/install-deps.sh` yourself
# when you want to actually build a lab. Override knobs for that script live
# in win11-forge, not here.
WINFORGE_REPO_URL="${WINFORGE_REPO_URL:-https://github.com/eip-public/win11-forge}"
WINFORGE_BRANCH="${WINFORGE_BRANCH:-main}"
WINFORGE_DIR="${WINFORGE_DIR:-}"                   # defaults to $TARGET_HOME/win11-forge inside the component

# ------------------ Security-tools toggles (50-* through 85-*) -------------
# These mirror the upstream install-tools-ubuntu2404.sh toggles. The script
# tests them as "1"/"0"; lib/security-tools.sh normalizes truthy values
# coming from this file. Set any to 0 (or false) to skip that piece.
INSTALL_BRAVE="${INSTALL_BRAVE:-1}"               # Brave browser
INSTALL_GH="${INSTALL_GH:-1}"                     # GitHub CLI
INSTALL_METASPLOIT="${INSTALL_METASPLOIT:-1}"     # Metasploit Framework apt repo + package
INSTALL_BURP="${INSTALL_BURP:-1}"                 # Burp Suite Community under /opt/BurpSuiteCommunity
INSTALL_GHIDRA_MCP="${INSTALL_GHIDRA_MCP:-1}"     # ghidra-headless-mcp wrapper
INSTALL_WINE="${INSTALL_WINE:-1}"                 # wine + winetricks
APPLY_USER_PERMISSIONS="${APPLY_USER_PERMISSIONS:-1}"  # add invoking user to docker/kvm/plugdev
ALLOW_UNSUPPORTED="${ALLOW_UNSUPPORTED:-0}"       # bypass Ubuntu 24.04 guard
